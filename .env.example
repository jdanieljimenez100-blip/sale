# Supabase (publishable keys may use NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# pey: mock | real
PEY_MODE=mock
PEY_API_KEY=
# Standard Webhooks (librería `standardwebhooks`): acepta el secreto con o sin
# prefijo `whsec_`. Si viene con `whsec_`, la librería lo quita sola antes de
# decodificar en base64. Copia el valor exacto que muestra portal.mipey.mx.
PEY_WEBHOOK_SECRET=
# ULID de pey de una cuenta CoDi con codiStatus ACTIVE (NO es la CLABE)
PEY_BANK_ACCOUNT_RESTAURANTE=
PEY_BANK_ACCOUNT_MESERO=

# Shared secret for mutating demo routes (header x-demo-token).
# En producción usa un valor distinto al de desarrollo (el repo es público).
DEMO_ACCESS_TOKEN=cambia-esto
